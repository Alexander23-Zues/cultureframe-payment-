NODE_ENV=development
PORT=4000
VITE_PORT=5175
APP_URL=http://localhost:5175
# SQLite is the explicitly labeled local development fallback.
DATABASE_URL=file:./development.db
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@cultureframe.com
ADMIN_INITIAL_PASSWORD=
INTEGRATION_MODE=simulator
# MySQL: mysql://USER:PASSWORD@HOST:3306/cultural_product_payments
# Generate the MySQL client before running with a MySQL URL (see README).
CULTUREFRAME_API_URL=
CULTUREFRAME_API_TOKEN=
# Automatic incremental order polling; minimum 60000 ms. Set to false to require manual synchronization.
INTEGRATION_AUTO_SYNC=true
INTEGRATION_SYNC_INTERVAL_MS=300000
CULTUREFRAME_WEBHOOK_SECRET=
# Custom HMAC gateway adapter only; this is not a plug-and-play GCash/Maya gateway.
PAYMENT_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional docker compose MySQL setup:
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
